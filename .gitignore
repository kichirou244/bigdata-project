# --- môi trường ảo & secret ---
.venv/
venv/
__pycache__/
*.py[cod]
.env

# --- dữ liệu lớn: KHÔNG commit raw / processed / work ---
data/raw/*
!data/raw/.gitkeep
# ... NHƯNG commit manifest.json (vài KB) -> evidence TRACE khớp raw file, GV audit được
!data/raw/*/
!data/raw/*/ingest_date=*/
!data/raw/*/ingest_date=*/run_*/
data/raw/*/ingest_date=*/run_*/*
!data/raw/*/ingest_date=*/run_*/manifest.json
data/processed/*
!data/processed/.gitkeep
# CSV chunk đã chuẩn hóa (derived từ raw, không commit)
data/work/*
!data/work/.gitkeep

# --- evidence runtime: COMMIT log (vài KB) để GV clone repo là thấy bằng chứng ---
logs/*
!logs/.gitkeep
!logs/*.txt
!logs/*.log

# --- Spark local ---
spark-warehouse/
metastore_db/
derby.log

# --- binary Hadoop (winutils) tải theo hướng dẫn README mục 2b ---
hadoop/

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
~$*.docx   # file khoá tạm của Word (~$...docx)
